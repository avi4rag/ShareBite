# Server: set these in Render's Environment tab for production.
NODE_ENV=development
PORT=4000
MONGO_URI=
JWT_SECRET=
CLIENT_URL=https://sharebite-anurag.vercel.app,http://localhost:5173,http://127.0.0.1:5173
SEED_ON_START=true
DEMO_MODE=true

# Client: set these in Vercel's Environment Variables, or in client/.env.local.
# Vite does not read VITE_ values from this root file when client/ is its root.
VITE_API_URL=https://sharebite-3zgy.onrender.com
VITE_SOCKET_URL=https://sharebite-3zgy.onrender.com
